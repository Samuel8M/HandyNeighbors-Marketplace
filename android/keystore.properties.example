# Copy this file to keystore.properties (same directory) and fill in the
# real values — keystore.properties is gitignored and must never be committed.
# storeFile is relative to android/app/ (android.keystore already lives there,
# restored from the original TWA project so this remains the same signing
# key the app is already published under on Google Play).
storeFile=android.keystore
storePassword=
keyAlias=android
keyPassword=
